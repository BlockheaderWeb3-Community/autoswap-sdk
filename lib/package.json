{
  "name": "autoswap-sdk",
  "version": "1.0.6",
  "description": "TypeScript SDK for interacting with AutoSwappr function",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:integration": "npx tsx integration-test.ts",
    "swap:strk-usdc": "npx tsx strk-usdc-swap-test.ts",
    "swap:usdc-strk": "npx tsx usdc-strk-swap-test.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "starknet",
    "cairo",
    "defi",
    "swap",
    "ekubo",
    "autoswappr"
  ],
  "author": "Ejembi Emmanuel",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.1",
    "starknet": "^7.6.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BlockheaderWeb3-Community/autoswap-sdk.git"
  },
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
}
